{
    "name": "campus-facility-management-system",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "node --watch src/server.js",
        "start": "node src/server.js",
        "seed": "node prisma/seed.js",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write . && npm run prisma:format",
        "format:check": "prettier --check . && npm run prisma:format:check",
        "prisma:validate": "prisma validate --config prisma7.config.ts",
        "prisma:format": "prisma format --config prisma7.config.ts",
        "prisma:format:check": "prisma format --check --config prisma7.config.ts",
        "check:syntax": "node scripts/check-syntax.js",
        "test": "node --test tests/*.test.js",
        "test:integration": "node --test tests/integration/*.test.js",
        "audit": "npm audit --audit-level=high",
        "quality": "npm run prisma:validate && npm run format:check && npm run check:syntax && npm run lint && npm test"
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "bcrypt": "^6.0.0",
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.12.0",
        "globals": "17.13.0",
        "prettier": "3.9.10",
        "prisma": "7.10.1"
    }
}
